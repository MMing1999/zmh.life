<!-- Content1: 留言表单区域 -->
<div class="content1">
  <!-- 1-left: 左侧栏（20%） -->
  <div class="content1-left"></div>
  
  <!-- 1-right: 右侧栏（80%） -->
  <div class="content1-right">
    <form id="message-form" class="message-form">
      <input 
        type="text" 
        id="message-user-id" 
        placeholder="用户ID" 
        required
        class="message-input message-input-user-id"
      />
      <span class="tab-separator">/</span>
      <input 
        type="text" 
        id="message-content" 
        placeholder="用户留言" 
        required
        class="message-input"
      />
      <button 
        type="submit"
        class="message-submit-btn"
      >发送</button>
    </form>
  </div>
</div>

<!-- Content2: 留言显示区域 -->
<div class="content2">
  <!-- 2-left: 左侧栏（20%）显示时间 -->
  <div class="content2-left" id="messages-time-list">
    <!-- 时间列表将通过 JavaScript 动态加载 -->
  </div>

  <!-- 2-right: 右侧栏（80%）显示留言内容 -->
  <div class="content2-right" id="messages-content-list">
    <!-- 留言列表将通过 JavaScript 动态加载 -->
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('message-form');
  const userIdInput = document.getElementById('message-user-id');
  const contentInput = document.getElementById('message-content');
  const timeList = document.getElementById('messages-time-list');
  const contentList = document.getElementById('messages-content-list');

  // 用户ID输入实时限制（10个中文字符或20个英文字符）
  userIdInput.addEventListener('input', function(e) {
    let value = e.target.value;
    let charCount = 0;
    let newValue = '';
    
    for (let i = 0; i < value.length; i++) {
      const char = value.charAt(i);
      let charLength = 0;
      
      // 判断是否为中文字符（包括中文标点）
      if (/[\u4e00-\u9fa5\u3000-\u303f\uff00-\uffef]/.test(char)) {
        charLength = 2;
      } else {
        charLength = 1;
      }
      
      // 如果加上这个字符不超过限制，则添加
      if (charCount + charLength <= 20) {
        charCount += charLength;
        newValue += char;
      } else {
        // 超过限制，停止添加
        break;
      }
    }
    
    // 如果值被截断了，更新输入框的值
    if (newValue !== value) {
      e.target.value = newValue;
    }
  });

  // 示例留言数据（从Notion获取后会替换）
  let messages = [];

  // 加载留言列表（预留Notion API接口）
  async function loadMessages() {
    try {
      // TODO: 调用Notion API获取留言
      // const response = await fetch('/api/messages');
      // if (response.ok) {
      //   messages = await response.json();
      //   displayMessages(messages);
      // }
      
      // 暂时使用示例数据或空数组
      displayMessages(messages);
    } catch (error) {
      console.error('加载留言失败:', error);
      displayMessages([]);
    }
  }

  // 显示留言列表
  function displayMessages(msgs) {
    if (!msgs || msgs.length === 0) {
      timeList.innerHTML = '';
      contentList.innerHTML = '<div style="color: #cdcdcd; font-family: \'Fusion Pixel\', monospace;">暂无留言</div>';
      return;
    }

    // 在左侧显示时间列表
    timeList.innerHTML = msgs.map(msg => {
      const timestamp = formatDateTime(msg.createdAt || msg.date);
      const [datePart, timePart] = timestamp.split(' ');
      // 桌面端显示完整时间，移动端显示分离的日期和时间
      return `<div class="messagesCraatTime"><span class="time-full">${timestamp}</span><div class="time-date">${datePart}</div><div class="time-hour">${timePart}</div></div>`;
    }).join('');

    // 在右侧显示留言内容（用户id / 用户留言内容，3:7比例）
    contentList.innerHTML = msgs.map(msg => {
      const userId = escapeHtml(msg.userId || msg.name || '匿名');
      const content = escapeHtml(msg.content || msg.message || '');
      return `
        <div class="message-item">
          <span class="message-user-id">${userId}</span>
          <span class="tab-separator">/</span>
          <span class="message-user-content">${content}</span>
        </div>
      `;
    }).join('');
  }

  // 格式化日期时间：2025.11.3 21:27
  function formatDateTime(dateString) {
    if (!dateString) return '';
    const date = new Date(dateString);
    const year = date.getFullYear();
    const month = date.getMonth() + 1;
    const day = date.getDate();
    const hours = date.getHours();
    const minutes = date.getMinutes();
    return `${year}.${month}.${day} ${hours}:${String(minutes).padStart(2, '0')}`;
  }

  // HTML 转义
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // 提交留言
  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const userId = userIdInput.value.trim();
    const content = contentInput.value.trim();

    // 验证：ID和留言都必须填写
    if (!userId || !content) {
      alert('请填写用户ID和留言内容');
      return;
    }

    // 验证：用户ID长度限制（10个中文字符或20个英文字符）
    // 中文字符占2个位置，英文字符占1个位置
    let charCount = 0;
    for (let i = 0; i < userId.length; i++) {
      const char = userId.charAt(i);
      // 判断是否为中文字符（包括中文标点）
      if (/[\u4e00-\u9fa5\u3000-\u303f\uff00-\uffef]/.test(char)) {
        charCount += 2;
      } else {
        charCount += 1;
      }
    }
    
    if (charCount > 20) {
      alert('用户ID不能超过10个中文字符或20个英文字符');
      return;
    }

    try {
      // TODO: 提交到Notion API
      // const response = await fetch('/api/messages', {
      //   method: 'POST',
      //   headers: {
      //     'Content-Type': 'application/json',
      //   },
      //   body: JSON.stringify({
      //     userId: userId,
      //     content: content
      //   })
      // });

      // if (response.ok) {
      //   // 清空表单
      //   form.reset();
      //   // 重新加载留言列表（Notion会自动添加时间戳）
      //   await loadMessages();
      //   alert('留言发送成功！');
      // } else {
      //   const error = await response.json();
      //   alert(error.message || '留言发送失败');
      // }

      // 暂时模拟成功（实际会从Notion返回数据）
      const newMessage = {
        userId: userId,
        content: content,
        createdAt: new Date().toISOString(), // Notion会自动添加，这里仅作演示
        date: new Date().toISOString()
      };

      messages.unshift(newMessage); // 添加到开头
      displayMessages(messages);

      // 清空表单
      form.reset();
      alert('留言发送成功！');
    } catch (error) {
      console.error('提交留言失败:', error);
      alert('留言发送失败，请稍后重试');
    }
  });

  // 初始加载
  loadMessages();
});
</script>
